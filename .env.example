# Neon Serverless PostgreSQL
DATABASE_URL="postgresql://user:password@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Google AI Studio (Gemini 3.5 Flash Lite & Gemini Embedding 2)
GEMINI_API_KEY="your-gemini-api-key"

# Cloudflare R2 (Private Bucket + Presigned URL)
R2_ACCOUNT_ID="your-r2-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="next-role"
R2_ENDPOINT="https://your-r2-account-id.r2.cloudflarestorage.com"

# Auth.js v5 (Google OAuth + Session Secret)
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_GOOGLE_ID="your-google-oauth-client-id"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"
